    "ServiceContract": {
      "title": "ServiceContract",
      "description": "Service employment contract (จ้างเหมาบริการ) linked to a personnel member, printable for wet signatures.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personnelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contractNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contractDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "startDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "endDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "durationMonths": {
          "type": "number"
        },
        "monthlyFee": {
          "type": "number"
        },
        "totalValue": {
          "type": "number"
        },
        "orgName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "orgAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "employerRepresentative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "employerPosition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "contractorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "contractorNationalId": {
          "type": "string",
          "minLength": 13,
          "maxLength": 20
        },
        "contractorAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "contractorPhone": {
          "type": "string",
          "maxLength": 30
        },
        "positionTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "workingHours": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scopeOfWork": {
          "type": "array",
          "description": "Bounded list of scope of work deliverables (max 20 items)."
        },
        "paymentTerms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "penaltyTerms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "witness1": {
          "type": "string",
          "maxLength": 160
        },
        "witness2": {
          "type": "string",
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["ร่างสัญญา", "รอลงนาม", "มีผลบังคับใช้", "สิ้นสุดสัญญา"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
