        "ownerId",
        "personnelId",
        "contractNumber",
        "contractDate",
        "startDate",
        "endDate",
        "durationMonths",
        "monthlyFee",
        "totalValue",
        "orgName",
        "orgAddress",
        "employerRepresentative",
        "employerPosition",
        "contractorName",
        "contractorNationalId",
        "contractorAddress",
        "positionTitle",
        "department",
        "workLocation",
        "workingHours",
        "scopeOfWork",
        "paymentTerms",
        "penaltyTerms",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/orgSettings/{settingId}": {
      "schema": { "$ref": "#/entities/OrganizationSetting" },
      "description": "Workspace organization settings keyed by owner UID."
    },
    "/personnel/{personnelId}": {
      "schema": { "$ref": "#/entities/Personnel" },
      "description": "Personnel registry records owned by the authenticated HR user."
    },
    "/payrolls/{payrollId}": {
      "schema": { "$ref": "#/entities/PayrollRecord" },
      "description": "Monthly payroll records linked to a personnel record."
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/ServiceContract" },
      "description": "Service employment contracts (จ้างเหมาบริการ) linked to a personnel record."
    }
  }
}
