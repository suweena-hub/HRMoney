        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personnelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "personnelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "employeeCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "position": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "month": {
          "type": "number"
        },
        "year": {
          "type": "number"
        },
        "baseSalary": {
          "type": "number"
        },
        "otHours": {
          "type": "number"
        },
        "otAmount": {
